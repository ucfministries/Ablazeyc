# ============================================================
# ABLAZE WEB — ENVIRONMENT / CONFIG REFERENCE
# ------------------------------------------------------------
# Mostly a STATIC site. Browser-side values (Shopify token,
# analytics IDs) can be pasted into JS or injected via Netlify.
# The Asana intake function (netlify/functions/submit-form.js)
# DOES read real env vars at runtime — set those in the Netlify
# dashboard (Site settings -> Environment variables), or in a
# local .env when running `netlify dev`.
# NEVER commit real secrets. (.env is gitignored; .env.example
# is safe to commit.)
# ============================================================

# --- SHOPIFY STOREFRONT (client-side product fetch) ---
# The Storefront token is PUBLIC / publishable (like a Stripe
# publishable key) and is safe to expose in browser code.
# NEVER use an Admin API token here (those start with shpat_).
SHOPIFY_STORE_DOMAIN=merch.discovertheu.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_token_here

# Where to use it (pick one):
#   A) Paste the token into site/shopify-config.js -> storefrontToken
#   B) Netlify: Site settings -> Build & deploy -> Post processing ->
#      Snippet injection -> add before </head>:
#        <script>window.ABLAZE_SHOPIFY_TOKEN="<your token>";</script>
#      (shopify-config.js reads window.ABLAZE_SHOPIFY_TOKEN automatically)
#   C) Leave blank -> site shows the curated fallback grid + store links.

# --- ANALYTICS (all optional; blank = disabled, no fake IDs) ---
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=

# How to turn analytics on (pick one):
#   A) Edit the defaults in site/scripts.js (top of file).
#   B) Netlify Snippet Injection before </head>:
#        <script>window.ABLAZE_CONFIG={
#          ga4Id:"G-XXXXXXX",
#          metaPixelId:"123456789012345",
#          tiktokPixelId:"CXXXXXXXXXXXXXXXXX"
#        };</script>
#      scripts.js merges window.ABLAZE_CONFIG over its defaults and only
#      loads each pixel when its ID is non-empty.

# --- ASANA INTAKE (server-side ONLY — read by netlify/functions/submit-form.js) ---
# ONE real secret read at runtime. Set it in the Netlify dashboard
# (Site settings -> Environment variables) for production, or in a local .env for
# `netlify dev`. It is NEVER sent to the browser. See ASANA_SETUP.md.
#
# Asana Personal Access Token — Asana -> My Settings -> Apps -> Personal access tokens
ASANA_ACCESS_TOKEN=your_token_here
# NOTE: the workspace + project ids are NOT env vars anymore. They live in
# submit-form.js next to the section ids (a matched set — pointing the env var
# at the wrong project once broke every submission). ASANA_WORKSPACE_ID /
# ASANA_PROJECT_ID in Netlify are ignored and can be deleted.
# OPTIONAL alert/backup webhook (Slack/Zapier/Make). If Asana ever rejects a task,
# the submission is logged AND posted here so nothing is lost. Leave blank to skip.
FALLBACK_WEBHOOK_URL=

# --- REQUEST NOTIFICATIONS (who hears about a new website request) ---
# Every request is announced to markellis0404@gmail.com and worship@ucfministries.org
# over THREE independent channels. Two of them need no configuration at all:
#
#   1. Asana followers — both addresses are Asana workspace members and are added
#      as followers on every task the function creates, so Asana emails them the
#      card. Always on; the gids are hardcoded in submit-form.js (NOTIFY_*).
#   2. Netlify Forms notifications — configured on the site itself (Site settings
#      -> Forms -> Notifications). One explicitly-scoped hook per form per
#      recipient; no unscoped "any form" hooks (their scoping semantics are
#      ambiguous). These are the backstop for the failure that has actually
#      bitten us: the visitor's browser never reaches the function, so the native
#      form fallback files the submission in Netlify Forms and no task is created.
#        booking/contact/press/sponsor -> markellis0404@gmail.com,
#                                         worship@ucfministries.org,
#                                         miracleucfm@gmail.com
#        scholarship                   -> miracleucfm@gmail.com only
#                                         (minors' PII; not routed to Asana either)
#   3. Direct transactional email — the OPTIONAL keys below. Set ONE of them and
#      submit-form.js also sends its own branded email, including on the path
#      where Asana rejected the task (channel 1 cannot fire there — no task
#      exists to follow). Leave both blank and this channel is silently skipped.
#
# Resend (https://resend.com) — preferred; verify the ablazeyc.com domain first.
RESEND_API_KEY=
# ...or SendGrid, if that's already in use. Only one is needed; Resend wins.
SENDGRID_API_KEY=
# Sender address for channel 3. MUST be a verified sender/domain at the provider
# above or the send is rejected. Defaults to "Ablaze Website <noreply@ablazeyc.com>".
NOTIFY_FROM_EMAIL=
